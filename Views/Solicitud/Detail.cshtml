@model PlataformaCreditos.ViewModels.SolicitudListViewModel
@{
    ViewData["Title"] = "Detalle Solicitud #" + Model.Id;
}

<h1>Detalle de Solicitud #@Model.Id</h1>

<div class="card mb-4">
    <div class="card-header @Model.EstadoLabel bg-@Model.EstadoLabel text-white">
        <h4>@Model.Estado</h4>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-4">ID</dt>
            <dd class="col-sm-8">@Model.Id</dd>

            <dt class="col-sm-4">Monto Solicitado</dt>
            <dd class="col-sm-8">@Model.MontoSolicitado.ToString("C")</dd>

            <dt class="col-sm-4">Fecha de Solicitud</dt>
            <dd class="col-sm-8">@Model.FechaSolicitud.ToString("dd/MM/yyyy HH:mm")</dd>

            <dt class="col-sm-4">Estado</dt>
            <dd class="col-sm-8">
                <span class="badge bg-@Model.EstadoLabel">@Model.Estado</span>
            </dd>

            @if (!string.IsNullOrEmpty(Model.MotivoRechazo))
            {
                <dt class="col-sm-4">Motivo de Rechazo</dt>
                <dd class="col-sm-8">@Model.MotivoRechazo</dd>
            }
        </dl>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-outline-secondary">Volver al Listado</a>
</div>
