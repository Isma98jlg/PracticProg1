@model PlataformaCreditos.Controllers.AnalistaSolicitudViewModel
@{
    ViewData["Title"] = "Detalle Solicitud #" + Model.Id;
}

<h1>Detalle de Solicitud #@Model.Id</h1>

<div class="card mb-4">
    <div class="card-header @(Model.ExcedeLimite ? "bg-danger" : "bg-info") text-white">
        <h4>Estado: @Model.Estado @(Model.ExcedeLimite ? "⚠️ Excede Límite" : "")</h4>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">ID</dt>
            <dd class="col-sm-9">@Model.Id</dd>

            <dt class="col-sm-3">Cliente</dt>
            <dd class="col-sm-9">@Model.ClienteNombre</dd>

            <dt class="col-sm-3">Monto Solicitado</dt>
            <dd class="col-sm-9">@Model.MontoSolicitado.ToString("C")</dd>

            <dt class="col-sm-3">Ingresos Mensuales</dt>
            <dd class="col-sm-9">@Model.IngresosMensuales.ToString("C")</dd>

            <dt class="col-sm-3">Límite de Aprobación (5x)</dt>
            <dd class="col-sm-9">@Model.MaxAprobacion.ToString("C")</dd>

            @if (Model.ExcedeLimite)
            {
                <div class="alert alert-danger">
                    ⚠️ <strong>Advertencia:</strong> El monto excede 5 veces los ingresos mensuales. No se puede aprobar.
                </div>
            }

            <dt class="col-sm-3">Fecha de Solicitud</dt>
            <dd class="col-sm-9">@Model.FechaSolicitud.ToString("dd/MM/yyyy HH:mm")</dd>

            <dt class="col-sm-3">Estado</dt>
            <dd class="col-sm-9">
                <span class="badge bg-@(Model.Estado == "Aprobado" ? "success" : Model.Estado == "Rechazado" ? "danger" : "warning")">@Model.Estado</span>
            </dd>

            @if (!string.IsNullOrEmpty(Model.MotivoRechazo))
            {
                <dt class="col-sm-3">Motivo de Rechazo</dt>
                <dd class="col-sm-9">@Model.MotivoRechazo</dd>
            }
        </dl>
    </div>
</div>

@if (Model.Estado == "Pendiente" && !Model.ExcedeLimite)
{
    <div class="row">
        <div class="col-md-6">
            <form asp-action="Approve" asp-route-id="@Model.Id" method="post" class="mb-2">
                <button type="submit" class="btn btn-success btn-lg w-100">✅ Aprobar Solicitud</button>
            </form>
        </div>
        <div class="col-md-6">
            <a asp-action="Reject" asp-route-id="@Model.Id" class="btn btn-danger btn-lg w-100">❌ Rechazar Solicitud</a>
        </div>
    </div>
}

@if (Model.ExcedeLimite)
{
    <div class="alert alert-warning">
        <strong>Nota:</strong> No se puede aprobar esta solicitud porque el monto excede el límite de 5x los ingresos mensuales.
    </div>
}

<div class="mt-3">
    <a asp-action="Index" class="btn btn-outline-secondary">Volver al Panel</a>
</div>
