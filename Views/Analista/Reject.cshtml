@model PlataformaCreditos.Controllers.AnalistaSolicitudViewModel
@{
    ViewData["Title"] = "Rechazar Solicitud #" + Model.Id;
}

<h1>Rechazar Solicitud #@Model.Id</h1>

<div class="card mb-4">
    <div class="card-header bg-danger text-white">
        <h4>Rechazar Solicitud</h4>
    </div>
    <div class="card-body">
        <dl class="row mb-4">
            <dt class="col-sm-4">Cliente</dt>
            <dd class="col-sm-8">@Model.ClienteNombre</dd>

            <dt class="col-sm-4">Monto Solicitado</dt>
            <dd class="col-sm-8">@Model.MontoSolicitado.ToString("C")</dd>

            <dt class="col-sm-4">Ingresos Mensuales</dt>
            <dd class="col-sm-8">@Model.IngresosMensuales.ToString("C")</dd>

            <dt class="col-sm-4">Límite de Aprobación</dt>
            <dd class="col-sm-8">@Model.MaxAprobacion.ToString("C")</dd>
        </dl>

        <form asp-action="Reject" asp-route-id="@Model.Id" method="post">
            <div class="mb-3">
                <label for="motivo" class="form-label">Motivo del Rechazo (obligatorio)</label>
                <textarea name="motivo" class="form-control" rows="4" placeholder="Escribe el motivo del rechazo..." required></textarea>
                <span asp-validation-for="MotivoRechazo" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-danger">Confirmar Rechazo</button>
            <a asp-action="Detail" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancelar</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
