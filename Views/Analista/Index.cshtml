@model List<PlataformaCreditos.Models.SolicitudCredito>
@{
    ViewData["Title"] = "Panel de Analista";
}

<h1>Panel de Analista</h1>

<div class="card mb-4">
    <div class="card-header bg-warning text-dark">
        <h5>Solicitudes Pendientes</h5>
    </div>
    <div class="card-body">
        <p class="text-muted">Revisa y evalúa las solicitudes de crédito que están pendientes de aprobación.</p>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (Model.Any())
{
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Cliente</th>
                <th>Monto</th>
                <th>Ingresos</th>
                <th>Fecha</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var solicitud in Model)
            {
                var maxMonto = solicitud.Cliente.IngresosMensuales * 5;
                var excedeLimite = solicitud.MontoSolicitado > maxMonto;
                var rowClass = excedeLimite ? "table-danger" : "";

                <tr class="@rowClass">
                    <td>@solicitud.Id</td>
                    <td>@solicitud.Cliente.UsuarioId</td>
                    <td>@solicitud.MontoSolicitado.ToString("C")</td>
                    <td>@solicitud.Cliente.IngresosMensuales.ToString("C") <small class="text-muted">(max @maxMonto:C)</small></td>
                    <td>@solicitud.FechaSolicitud.ToString("dd/MM/yyyy")</td>
                    <td>
                        <a asp-action="Detail" asp-route-id="@solicitud.Id" class="btn btn-sm btn-outline-primary">Detalle</a>
                        @if (!excedeLimite)
                        {
                            <form asp-action="Approve" asp-route-id="@solicitud.Id" method="post" style="display:inline">
                                <button type="submit" class="btn btn-sm btn-success">Aprobar</button>
                            </form>
                        }
                        <a asp-action="Reject" asp-route-id="@solicitud.Id" class="btn btn-sm btn-danger">Rechazar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info">No hay solicitudes pendientes.</div>
}

<div class="mt-3">
    <a asp-action="Index" asp-controller="Home" class="btn btn-outline-secondary">Volver al Inicio</a>
</div>
