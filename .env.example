# ASP.NET Core
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://0.0.0.0:${PORT}

# Database
ConnectionStrings__DefaultConnection=DataSource=app.db;Cache=Shared

# Render Configuration
# - Set ASPNETCORE_ENVIRONMENT=Production in Render dashboard
# - Set ASPNETCORE_URLS=http://0.0.0.0:${PORT} in Render dashboard
# - Set ConnectionStrings__DefaultConnection in Render dashboard